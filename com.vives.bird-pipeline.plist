<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- 2026-09-18: AIY-only. The 12-class yard model's guesses had been the canonical
		     snapshot labels since 2026-04-25 (71% of the flagship manifest); see
		     bird-classifier-pi/docs/working/specs/2026-09-17-flagship-postmortem.md -->
		<key>DISABLE_CORAL</key>
		<string>1</string>
		<key>PIPELINE_DB_PATH</key>
		<string>/Users/vives/bird-snapshots/logs/pipeline.db</string>
		<key>PIPELINE_HEALTH_PORT</key>
		<string>8100</string>
		<key>PIPELINE_NIGHT_BYPASS</key>
		<string>0</string>
		<key>PIPELINE_SSE_PORT</key>
		<string>8105</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.vives.bird-pipeline</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/vives/bin/bird-pipeline-run.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/vives/bird-snapshots/logs/pipeline-stderr.log</string>
